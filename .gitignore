# ===== macOS junk =====
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ===== Obsidian — keep vault config, exclude per-workspace state =====
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# ===== Python / Jupyter =====
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.python-version
.venv/
venv/
env/
*.egg-info/

# ===== R =====
.Rhistory
.RData
.Rproj.user/

# ===== Editor / IDE =====
.vscode/
.idea/
*.swp
*.swo

# ===== Local-only artefacts =====
# Add anything per-machine here. Project source PDFs (Zymo, AAT Bioquest, prof's docx)
# are intentionally committed for team reference — see README.md attribution section.

# ===== large genome / metagenome sequence data (kept on disk, not in git) =====
data/metagenomes/*.faa
# raw phage sequencing reads (paired-end fastq, ~600 MB each; vendor-delivered)
data/phage_genome/**/*.fastq.gz
# bulky per-genome annotation formats (keep the compact .faa/.tsv/plots instead)
data/bacteria_genome/**/*.json
data/bacteria_genome/**/*.gbff
data/bacteria_genome/**/*.gbk
data/bacteria_genome/**/*.embl
data/bacteria_genome/**/*.gff3
data/bacteria_genome/**/*.fna
data/bacteria_genome/**/*.ffn
# 0623 metagenome-RBP: downloaded NCBI reference genomes & the ANI hit dump
code/0623_metagenome_rbp/out_finding_rbps/ani/hit_genomes/
code/0623_metagenome_rbp/out_finding_rbps/ani/refs_raw/
code/0623_metagenome_rbp/out_finding_rbps/ani/refs.zip
# mmseqs scratch dirs
code/output/**/mmseqs_tmp/
code/output/**/mmseqs_tmp_search/
# 0729 figures: the per-panel PyMOL / pyCirclize renders are intermediates that the
# assembled figures are tiled from — regenerate with the scripts, don't version them
code/output/0729_prof_figures/panels/
data/bacteria_genome/**/*.fasta
# 0708 phage assembly: Laguna-side data / envs / DBs / intermediates (git tracks scripts only —
# the workspace doubles as the clone dir on Laguna, so ignore everything the run creates there)
code/0708_phage_assembly/reads/
code/0708_phage_assembly/ref/
code/0708_phage_assembly/envs/
code/0708_phage_assembly/.conda_pkgs/
code/0708_phage_assembly/db/
code/0708_phage_assembly/**/work/
code/0708_phage_assembly/**/logs/
code/0708_phage_assembly/*.out

# 0716 Prof. Espinoza's AlphaFold3 folds of the tail cluster (CDS_0010/0011/0012).
# His 3 zips (51 MB) + their 460 MB of unpacked MSAs/PAE matrices stay on disk, like the raw
# reads above; git keeps only the compact derived evidence in code/output/0716_*.
data/phage_genome/9-2-1/folds_espinoza/
